{
  "manifest_version": 3,
  "name": "e-Consul Helper",
  "version": "0.2.0",
  "description": "Передає токен сесії e-consul у локальний застосунок моніторингу слотів і сповіщає, коли треба увійти.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "notifications", "offscreen", "tabs", "scripting"],
  "host_permissions": [
    "https://e-consul.gov.ua/*",
    "https://my.e-consul.gov.ua/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://e-consul.gov.ua/*"],
      "js": ["econsul.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "e-Consul Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
